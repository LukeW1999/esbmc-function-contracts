-- Contract Soundness Proofs for ASE '26 Paper
-- Pure Lean 4 core, no Mathlib dependency

attribute [local instance] Classical.propDecidable

/-! # 1. State Definition -/
structure State where
  vars   : String → Int
  is_err : Bool
  deriving Inhabited

/-! # 2. Phase 1: Soundness of Enforce Mode
    Models the verification wrapper generated by --enforce-contract.
    Theorem: if the precondition holds and no error was flagged,
    then the postcondition holds at the final state.
-/
noncomputable def contract_wrapper
  (impl : State → State)
  (req  : State → Prop)
  (ens  : State → State → Prop)
  (s0   : State) : State :=
  if req s0 then
    let s1 := impl s0
    if ens s0 s1 then s1 else { s1 with is_err := true }
  else
    s0

theorem phase1_enforcement_sound
  (impl : State → State) (req : State → Prop) (ens : State → State → Prop) (s0 : State) :
  let s_final := contract_wrapper impl req ens s0
  (req s0 ∧ ¬s_final.is_err) → ens s0 s_final := by
  intro s_final h_logic
  have h_def : s_final = contract_wrapper impl req ens s0 := rfl
  unfold contract_wrapper at h_def
  split at h_def
  · rename_i h_req
    dsimp only at h_def
    split at h_def
    · rename_i h_ens
      rw [h_def]; exact h_ens
    · rename_i h_not_ens
      rw [h_def] at h_logic; simp at h_logic
  · rename_i h_not_req
    rw [h_def] at h_logic; simp_all

/-! # 3. Phase 2: Soundness of Replace Mode (Contract Abstraction)
    abstract_transition models the call-site stub:
      assert pre, havoc assigns, assume post.
    Theorem: any property P that holds for all post-states
    is preserved by the abstract transition.
-/
def abstract_transition
  (req : State → Prop) (ens : State → State → Prop) (s0 : State) : State → Prop :=
  fun s => req s0 ∧ ens s0 s

theorem phase2_abstraction_sound
  (s0 : State) (req : State → Prop) (ens : State → State → Prop) (P : State → Prop) :
  (∀ s_any, ens s0 s_any → P s_any) →
  ∀ s_next, abstract_transition req ens s0 s_next → P s_next := by
  intro h_inference s_next h_abs
  exact h_inference s_next h_abs.right

/-! # 4. Phase 3: Soundness of Observational Frame Rule
    havoc models the Replace stub: nondeterministically change all variables
    NOT in vars_to_keep (the assigns clause).
    Theorem: if property P depends only on vars_to_keep, and P holds
    before havoc, then P holds after any havoc of other variables.
    This is the machine-checked proof that observational assigns semantics
    is sound for sequential programs.
-/
def havoc (s : State) (vars_to_keep : List String) : State → Prop :=
  fun s' => ∀ v, v ∈ vars_to_keep → s'.vars v = s.vars v

theorem phase3_havoc_sound
  (s : State) (vars_to_keep : List String) (P : State → Prop) :
  -- h_dep: P only observes variables in vars_to_keep
  -- (models: caller reads memory only after function returns)
  (∀ s1 s2, (∀ v ∈ vars_to_keep, s1.vars v = s2.vars v) → (P s1 ↔ P s2)) →
  P s →
  ∀ s_havoc, havoc s vars_to_keep s_havoc → P s_havoc := by
  intro h_dep h_p s_havoc h_is_havoc
  have h_same_vars : ∀ v ∈ vars_to_keep, s.vars v = s_havoc.vars v := by
    intro v hv
    rw [h_is_havoc v hv]
  have h_iff := h_dep s s_havoc h_same_vars
  exact h_iff.mp h_p

/-! # 5. Hoare Frame Rule Embedding
    Establishes that observational assigns semantics is a direct BMC
    encoding of the classical Hoare logic frame rule:
        {P} C {Q}    FV(F) ∩ Mod(C) = ∅
        ──────────────────────────────────
               {P ∧ F} C {Q ∧ F}

    observational_assigns(C, S) is the machine-checked side condition
    FV(F) ∩ Mod(C) = ∅: C does not modify variables outside S,
    so any frame property F that depends only on non-assigned variables
    is preserved through C.
-/

-- Hoare triple (partial correctness): if P holds at s, Q holds at C(s)
def hoare (P : State → Prop) (C : State → State) (Q : State → Prop) : Prop :=
  ∀ s, P s → Q (C s)

-- C satisfies observational assigns(S): variables outside S are unchanged
def observational_assigns (C : State → State) (S : List String) : Prop :=
  ∀ s v, v ∉ S → (C s).vars v = s.vars v

-- F is a frame condition: its truth depends only on vars_frame
def is_frame (F : State → Prop) (vars_frame : List String) : Prop :=
  ∀ s1 s2, (∀ v ∈ vars_frame, s1.vars v = s2.vars v) → (F s1 ↔ F s2)

theorem hoare_frame_rule
  (P Q F : State → Prop) (C : State → State) (S vars_frame : List String) :
  -- {P} C {Q}
  hoare P C Q →
  -- C satisfies observational assigns(S)
  observational_assigns C S →
  -- F is a frame condition over vars_frame
  is_frame F vars_frame →
  -- vars_frame are disjoint from S (frame variables are not assigned)
  (∀ v ∈ vars_frame, v ∉ S) →
  -- {P ∧ F} C {Q ∧ F}
  hoare (fun s => P s ∧ F s) C (fun s => Q s ∧ F s) := by
  intro h_hoare h_assigns h_frame h_disj s ⟨h_P, h_F⟩
  constructor
  · exact h_hoare s h_P
  · apply (h_frame s (C s) _).mp h_F
    intro v hv
    exact (h_assigns s v (h_disj v hv)).symm

/-! # 6. Contract Substitution Theorem
    Justifies the soundness of Replace mode as a conservative
    over-approximation: any property P provable against the abstract
    stub (which ranges over ALL states satisfying the postcondition)
    also holds for the concrete impl — provided impl satisfies the
    contract.  This is the key theorem connecting Enforce + Replace:
    if both phases pass, the concrete composed program is correct.
-/

theorem contract_substitution_sound
  (impl : State → State) (req : State → Prop) (ens : State → State → Prop)
  (P : State → Prop) (s0 : State) :
  -- impl satisfies its contract at s0
  req s0 → ens s0 (impl s0) →
  -- P holds for every state reachable via the abstract stub
  -- (this is exactly what Replace-mode BMC verifies)
  (∀ s', abstract_transition req ens s0 s' → P s') →
  -- conclusion: P holds for the concrete impl's output
  P (impl s0) := by
  intro h_req h_ens h_stub
  exact h_stub (impl s0) ⟨h_req, h_ens⟩

/-! # 7. Pointer Disjunction Soundness (Proposition 2)

The implementation extends the scalar assigns model to pointer-typed targets.
For `assigns(*ptr)`, the enforce wrapper generates one disjunctive assertion per
non-assigned global h at function exit:

    assert(h == snap_h  ∨  ptr == &h)

This section machine-checks that this mechanism is sound: when ptr is unmodified
and does not alias h at entry, the disjunction implies h satisfies the
observational assigns condition.

`ptr_disjunction_sound` is the direct machine-checked proof of Proposition 2.
`ptr_frame_compliance` shows the full integration: the conjunction of all
per-variable disjunctions plus the no-alias condition yields `observational_assigns`.
-/

section PointerDisjunction

variable {Address : Type}

/-- Core lemma (Proposition 2 machine-checked):
    If ptr is unmodified and did not alias h at function entry,
    then the disjunctive assertion implies h satisfies the
    observational assigns condition. -/
theorem ptr_disjunction_sound
    (h_exit snap_h : Int)
    (ptr_entry ptr_exit addr_of_h : Address)
    (h_ptr_unmodified : ptr_exit = ptr_entry)
    (h_no_alias       : ptr_entry ≠ addr_of_h)
    (h_assert         : h_exit = snap_h ∨ ptr_exit = addr_of_h) :
    h_exit = snap_h := by
  cases h_assert with
  | inl h_eq    => exact h_eq
  | inr h_alias =>
    rw [h_ptr_unmodified] at h_alias
    exact absurd h_alias h_no_alias

/-- Frame compliance via pointer disjunction (integration theorem):
    If for every non-assigned variable v the enforce wrapper's disjunctive
    assertion holds, AND ptr is unmodified, AND ptr does not alias any v ∉ S
    at function entry, THEN C satisfies observational_assigns S.
    This is the full soundness argument for the pointer assigns extension:
    one disjunction per global is generated; all are resolved by the
    no-alias condition, yielding the scalar observational assigns guarantee. -/
theorem ptr_frame_compliance
    (C       : State → State)
    (S       : List String)
    (addr_of : String → Address)
    (ptr_pre ptr_post : Address)
    (h_ptr_fixed : ptr_post = ptr_pre)
    (h_no_alias  : ∀ v, v ∉ S → ptr_pre ≠ addr_of v)
    (h_disj : ∀ s v, v ∉ S →
        (C s).vars v = s.vars v ∨ ptr_post = addr_of v) :
    observational_assigns C S := by
  intro s v h_not_S
  rcases h_disj s v h_not_S with h_eq | h_alias
  · exact h_eq
  · rw [h_ptr_fixed] at h_alias
    exact absurd h_alias (h_no_alias v h_not_S)

end PointerDisjunction

/-! # Summary: what the seven theorems together justify
    phase1_enforcement_sound    : Enforce wrapper correctly checks the contract
    phase2_abstraction_sound    : stub is a sound over-approximation of the spec
    phase3_havoc_sound          : selective havoc preserves frame properties
    hoare_frame_rule            : observational assigns = Hoare frame side condition
    contract_substitution_sound : Replace mode is sound w.r.t. the real impl
    ptr_disjunction_sound       : Proposition 2 — pointer disjunction is sound
    ptr_frame_compliance        : disjunctions + no-alias → observational assigns

    Together: the Enforce+Replace pipeline is a mechanically verified
    implementation of modular Hoare-logic reasoning in the BMC setting,
    including the pointer-typed assigns extension.
-/

#check @phase1_enforcement_sound
#check @phase2_abstraction_sound
#check @phase3_havoc_sound
#check @hoare_frame_rule
#check @contract_substitution_sound
#check @ptr_disjunction_sound
#check @ptr_frame_compliance
